[Unit]
Description=GPI Touchdown router controller and setup portal
Wants=NetworkManager.service avahi-daemon.service
After=NetworkManager.service avahi-daemon.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/gpi-touchdown
Environment=PYTHONUNBUFFERED=1
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=WIFI_COUNTRY=US
EnvironmentFile=-/etc/default/gpi-touchdown
ExecStartPre=/usr/sbin/iw reg set ${WIFI_COUNTRY}
ExecStartPre=/usr/sbin/rfkill unblock wifi
ExecStart=/usr/bin/python3 /opt/gpi-touchdown/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
